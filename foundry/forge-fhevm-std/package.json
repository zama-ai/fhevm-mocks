{
  "name": "@fhevm/forge-std-dev",
  "version": "0.0.0",
  "description": "Dev package for @fhevm/forge-std. Never published. The published package is ./pkg.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run fmt:check && npm run lint && npm run compile",
    "check": "npm run check:publint",
    "check:publint": "publint --strict ./pkg",
    "clean": "npm run clean:forge && npm run clean:forge:fhevm-debug && npm run clean:tsbuildinfo",
    "clean:forge": "rm -rf cache out broadcast snapshots out-forgefhevmcore out-create2",
    "clean:forge:fhevm-debug": "rm -rf cache-fhevm-debug out-fhevm-debug",
    "clean:generate:forge-payload": "rm -rf pkg/src/_host",
    "clean:generate:version": "rm -rf pkg/src/StdFhevmVersion.sol",
    "clean:generated": "npm run clean:generate:forge-payload && npm run clean:generate:version",
    "clean:tsbuildinfo": "rm -f *.tsbuildinfo internal/*.tsbuildinfo",
    "compile": "npm run compile:forge",
    "compile:forge": "forge build --skip test",
    "fmt": "npm run prettier:write && npm run forge:fmt",
    "fmt:check": "npm run prettier:check && npm run forge:fmt:check",
    "forge:fmt": "forge fmt",
    "forge:fmt:check": "forge fmt --check",
    "forge:lint": "forge lint --no-cache",
    "generate": "npm run generate:pre && npm run compile:forge",
    "generate:forge-payload": "node internal/cli/generateForgePayload.ts",
    "generate:pre": "npm run generate:forge-payload && npm run generate:version",
    "generate:version": "node internal/cli/generateVersion.ts",
    "lint": "eslint && tsc -p ./internal/tsconfig.json --noEmit && npm run forge:lint",
    "pack:tarball": "node ../../fhevm-npm/fhevm-npm.ts publish pack ./foundry/forge-fhevm-std",
    "prettier:check": "prettier --check \"**/*.{js,json,md,mjs,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,mjs,ts,yml}\"",
    "test": "npm run test:forge",
    "test:anvil": "../../scripts/with-anvil.sh --port 8546 -- forge test --match-path 'test/anvil/*'",
    "test:anvil-mirror": "../../scripts/with-anvil.sh --port 8548 -- forge test --match-path 'test/anvilMirror/*'",
    "test:consumer": "node ../../fhevm-npm/fhevm-npm.ts test-consumer ./foundry/forge-fhevm-std --run --build-linked-dependencies",
    "test:consumer:dev": "node ../../fhevm-npm/fhevm-npm.ts test-consumer ./foundry/forge-fhevm-std/test-consumer/esm --run --ci",
    "test:forge": "forge test",
    "test:fork": "forge test --threads 2 --match-path 'test/fork/*'",
    "test:fork-debug": "FOUNDRY_PROFILE=fhevm-debug forge test --threads 2 --match-path 'test/fork/*'",
    "test:fork-url": "node internal/cli/testForkUrl.ts"
  },
  "devDependencies": {
    "@fhevm/solidity": "^0.13.3",
    "@types/node": "^22.0.0",
    "encrypted-types": "^0.0.4",
    "eslint": "^10.0.2",
    "prettier": "^3.8.3",
    "publint": "^0.2.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
