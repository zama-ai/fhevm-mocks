pragma solidity ^0.8.24;

import {Script} from "forge-std/Script.sol";

/// Writes ../fhevm-chain-aliases.json: for every host chain of fhevm-chains.config.json, the public alias and the
/// default RPC URL that forge-std's StdChains gives its chain ID. StdFhevmChains follows forge-std's StdChains, so
/// these two values are forge-std's, and asked of it rather than copied by hand. A host chain forge-std does not
/// know reverts here, with its chain ID, and that failure is intended: it stops `make generate` and `make ci` until
/// a forge-std version that knows the chain is installed. Never add an override or a fallback that lets such a
/// chain through: its alias and default RPC URL would then be invented here, not forge-std's.
///
/// Run: npm run generate:chain-aliases (it runs forge in this folder, with an empty environment; see foundry.toml).
contract ChainAliases is Script {
    string internal constant CONFIG = "../../../../fhevm-chains.config.json";
    string internal constant OUTPUT = "../fhevm-chain-aliases.json";

    function run() external {
        string memory config = vm.readFile(CONFIG);
        string[] memory groups = vm.parseJsonKeys(config, ".networks");

        string memory json = string.concat(
            "{",
            '"$comment":["GENERATED by internal/chain-aliases/ChainAliases.s.sol from forge-std\'s StdChains - do not edit',
            ' by hand.","For each host of fhevm-chains.config.json, the alias and default RPC URL that forge-std gives its',
            ' chain ID.","Run: npm run generate:chain-aliases"]'
        );
        for (uint256 g = 0; g < groups.length; g++) {
            string memory hostsPath = string.concat(".networks.", groups[g], ".hosts");
            string[] memory hosts = vm.parseJsonKeys(config, hostsPath);
            json = string.concat(json, ',"', groups[g], '":{');
            for (uint256 h = 0; h < hosts.length; h++) {
                uint256 chainId = vm.parseJsonUint(config, string.concat(hostsPath, ".", hosts[h], ".id"));
                Chain memory chain = getChain(chainId);
                _requireForgeStdDefault(chain.chainAlias);
                json = string.concat(
                    json,
                    h == 0 ? "" : ",",
                    '"',
                    hosts[h],
                    '":{"alias":"',
                    chain.chainAlias,
                    '","rpcUrl":"',
                    chain.rpcUrl,
                    '"}'
                );
            }
            json = string.concat(json, "}");
        }
        vm.writeFile(OUTPUT, string.concat(json, "}\n"));
    }

    /// getChain() returns forge-std's built-in default RPC URL only when nothing overrides it: no `[rpc_endpoints]`
    /// entry for the alias in any foundry.toml forge reads (this project's, or the global ~/.foundry/foundry.toml),
    /// and no `<ALIAS>_RPC_URL` variable (from the shell, or from a .env file forge loads). An override is often a
    /// private URL with a key in it, and the URL written here ends up in the published StdFhevmChains.sol. So any
    /// override stops the run instead of being written.
    function _requireForgeStdDefault(string memory chainAlias) internal view {
        string memory envName = string.concat(_upperCase(chainAlias), "_RPC_URL");
        require(
            !vm.envExists(envName),
            string.concat(
                "ChainAliases: ", envName, " is set (shell or .env), so forge-std would not return its default RPC URL"
            )
        );
        try vm.rpcUrl(chainAlias) returns (string memory) {
            revert(
                string.concat(
                    "ChainAliases: a foundry.toml gives \"",
                    chainAlias,
                    "\" an [rpc_endpoints] entry, so forge-std would not return its default RPC URL"
                )
            );
        } catch {}
    }

    /// A copy: `bytes(text)` shares the memory of `text`, and the alias is written to the JSON afterwards.
    function _upperCase(string memory text) internal pure returns (string memory) {
        bytes memory source = bytes(text);
        bytes memory upper = new bytes(source.length);
        for (uint256 i = 0; i < source.length; i++) {
            bytes1 c = source[i];
            upper[i] = c >= 0x61 && c <= 0x7a ? bytes1(uint8(c) - 32) : c;
        }
        return string(upper);
    }
}
