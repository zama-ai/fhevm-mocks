{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zama-ai/fhevm/blob/main/sdk/fhevm-npm/schemas/test-ports.config.schema.json",
  "title": "test ports configuration",
  "description": "Every TCP port on which a test of the workspace starts a local node, by group and name. Each group owns a range of ports.",
  "type": "object",
  "required": ["$schema", "_readme", "groups"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "./fhevm-npm/schemas/test-ports.config.schema.json" },
    "_readme": { "$ref": "#/$defs/proseLines" },
    "groups": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9][a-z0-9.-]*)*$" },
      "additionalProperties": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "proseLines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "group": {
      "type": "object",
      "required": ["range", "ports"],
      "additionalProperties": false,
      "properties": {
        "range": {
          "description": "The first and the last port of the group, both included.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/port" }
        },
        "ports": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "additionalProperties": { "$ref": "#/$defs/port" }
        }
      }
    }
  }
}
