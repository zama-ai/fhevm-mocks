    /// @notice The address `role` holds in `creationCode` above — what a repatch overwrites.
    function canonicalAddress(FhevmAddressRole role) internal pure returns (address) {
        if (role == FhevmAddressRole.ACL) return LocalHostAddresses.ACL_ADDRESS;
        if (role == FhevmAddressRole.FHEVMExecutor) return LocalHostAddresses.FHEVM_EXECUTOR_ADDRESS;
        if (role == FhevmAddressRole.KMSVerifier) return LocalHostAddresses.KMS_VERIFIER_ADDRESS;
        if (role == FhevmAddressRole.InputVerifier) return LocalHostAddresses.INPUT_VERIFIER_ADDRESS;
        if (role == FhevmAddressRole.HCULimit) return LocalHostAddresses.HCU_LIMIT_ADDRESS;
        if (role == FhevmAddressRole.ProtocolConfig) return LocalHostAddresses.PROTOCOL_CONFIG_ADDRESS;
        if (role == FhevmAddressRole.KMSGeneration) return LocalHostAddresses.KMS_GENERATION_ADDRESS;
        if (role == FhevmAddressRole.PauserSet) return LocalHostAddresses.PAUSER_SET_ADDRESS;
        if (role == FhevmAddressRole.CleartextArithmetic) return LocalHostAddresses.CLEARTEXT_ARITHMETIC_ADDRESS;
