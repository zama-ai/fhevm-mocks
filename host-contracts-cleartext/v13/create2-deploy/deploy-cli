#!/usr/bin/env bash
#
# Deploy a fresh cleartext FHEVM stack to a testnet through the CREATE2 factory. See DEPLOY.md.
#
#   deploy-cli --help
#
# Run it from your deployment folder: without --config it reads ./deploy.config.json there. It may be
# called through a symlink (e.g. one in ~/bin); the real location is resolved first, because the
# TypeScript it runs sits beside it in ts/.
set -euo pipefail

# Follow symlinks to this file's real directory. Plain `readlink` (no -f), which macOS and Linux share.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P -- "$(dirname -- "$src")" && pwd)"
  src="$(readlink -- "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
here="$(cd -P -- "$(dirname -- "$src")" && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "deploy-cli: node not found. Install Node.js >= 22.18 (https://nodejs.org)." >&2
  exit 1
fi
# Older Node versions fail on the .ts file with a syntax error that names nothing useful.
if [ "$(node -p 'process.features.typescript ? 1 : 0' 2>/dev/null)" != 1 ]; then
  echo "deploy-cli: Node.js $(node --version) cannot run TypeScript directly. Install Node.js >= 22.18." >&2
  exit 1
fi

exec node "$here/ts/deploy-testnet.ts" "$@"
