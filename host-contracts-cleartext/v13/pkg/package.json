{
  "name": "@fhevm/host-contracts-cleartext",
  "version": "0.13.0-1",
  "description": "FHEVM host contracts cleartext Solidity contracts",
  "license": "BSD-3-Clause-Clear",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zama-ai/fhevm-mocks.git",
    "directory": "host-contracts-cleartext/v13/pkg"
  },
  "main": "./ts/_cjs/index.js",
  "module": "./ts/_esm/index.js",
  "types": "./ts/_types/index.d.ts",
  "typings": "./ts/_types/index.d.ts",
  "typesVersions": {
    "*": {
      "ts": [
        "./ts/_types/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "abi",
    "templates",
    "ts",
    "forge",
    "LICENSE",
    "README.md",
    "!**/tsconfig*.json",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./ts/_types/index.d.ts",
        "default": "./ts/_esm/index.js"
      },
      "require": {
        "types": "./ts/_types-cjs/index.d.ts",
        "default": "./ts/_cjs/index.js"
      }
    },
    "./ts": {
      "import": {
        "types": "./ts/_types/index.d.ts",
        "default": "./ts/_esm/index.js"
      },
      "require": {
        "types": "./ts/_types-cjs/index.d.ts",
        "default": "./ts/_cjs/index.js"
      }
    },
    "./abi/*.json": "./abi/*.json",
    "./templates/*.json": "./templates/*.json",
    "./src/*": "./src/*",
    "./forge/*": "./forge/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0",
    "@openzeppelin/contracts-upgradeable": "5.1.0"
  },
  "fhevm": {
    "vendoredFrom": {
      "repository": "https://github.com/zama-ai/fhevm",
      "tag": "v0.13.6",
      "commit": "096ad11a3ac3aff466f2a5cf03788eae655311ca",
      "from": "host-contracts/contracts",
      "to": "src/contracts"
    }
  }
}
