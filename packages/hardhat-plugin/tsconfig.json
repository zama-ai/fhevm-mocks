{
  // This configuration is used for local development and type checking.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // TypeScript 6 requires this to be explicit rather than inferred from the include set: without
    // it, any consumer that emits through this config (ts-node, via `hardhat typechain`) fails with
    // TS5011. The package root is the common ancestor of src/, test/ and hardhat.config.ts.
    "rootDir": "."
  },
  // Dont forget to add "./typechain-types" otherwise ts typecheck will throw errors when calling hre.ethers.getContractFactory(...)
  "include": ["src", "test", "types", "hardhat.config.ts", "./typechain-types"]
}
