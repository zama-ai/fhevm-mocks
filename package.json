{
  "name": "fhevm-sdk-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "common",
    "common-vendored",
    "host-contracts-cleartext/v13",
    "host-contracts-cleartext/v14",
    "host-contracts-cleartext/v14/pkg",
    "foundry/forge-fhevm-std",
    "foundry/forge-fhevm-std/pkg"
  ],
  "scripts": {
    "build": "make build",
    "compile": "make compile",
    "test-engine:fork-devnet": "cd host-contracts-cleartext/v13 && ../../scripts/forge-test.sh --threads 2 --match-contract '^(ForkForgeVariantMeasurementTest|ForkForgeVariantUpgradeTest)$'",
    "test-engine:fork-mainnet": "cd host-contracts-cleartext/v13 && ../../scripts/forge-test.sh --threads 2 --match-contract '^(ForkUserDecryptTest|ForkCleartextContextTest)$'",
    "test-engine:fork-testnet": "cd host-contracts-cleartext/v13 && ../../scripts/forge-test.sh --threads 2 --match-contract '^(TestnetCleartextUpgradeTest)$'",
    "test-engine:fork-transient-storage": "cd host-contracts-cleartext/v13 && ../../scripts/forge-test.sh --threads 2 --match-contract '^(ForgeTransientStorageSemanticsTest)$'",
    "test-engine:suite": "npm run test-engine:suite:forge && npm run test:harness:run -w @fhevm/host-contracts-cleartext-v13-dev && npm run test:create2-deploy-e2e -w @fhevm/host-contracts-cleartext-v13-dev && npm run test:create2-hotfix-e2e -w @fhevm/host-contracts-cleartext-v13-dev",
    "test-engine:suite:forge": "cd host-contracts-cleartext/v13 && ../../scripts/forge-test.sh --no-match-contract '^(ForkForgeVariantMeasurementTest|ForkForgeVariantUpgradeTest|TestnetCleartextUpgradeTest|ForkUserDecryptTest|ForkCleartextContextTest|ForgeTransientStorageSemanticsTest)$'",
    "test-engine:templates": "npm run test:templates:run -w @fhevm/host-contracts-cleartext-v13-dev",
    "test:ci": "make ci"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "ethers": "6.17.0",
    "prettier": "^3.9.10",
    "publint": "^0.2.12",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "viem": "2.55.19",
    "vitest": "^4.1.12"
  }
}
