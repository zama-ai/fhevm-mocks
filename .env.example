# Environment variables of the tests of this workspace.
#
# Copy this file to `.env`, in the same folder, and fill in what you have:
#
#   cp .env.example .env
#
# `fhevm-npm test-engine` reads `.env` before a run. Git ignores `.env`, so a key written there is
# never committed. Never write a key in this file.
#
# A variable that your shell already exports wins over `.env`. A line with no value sets nothing.
# fhevm-npm-docs/TESTS.md says how to run the tests.

# The RPC URL of each live chain. A test that uses a chain, or a fork of it, does not start without
# the URL of that chain: the run lists the test as unavailable. A test that forks at a fixed block
# needs an RPC with archive state.
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
ARBITRUM_RPC_URL=

# Where the test engine writes its report and its logs. Unset, they go to the workspace root:
# test-report.json and test-logs/.
FHEVM_TEST_REPORT=
FHEVM_TEST_LOGS=

# How many of the last lines of a node's output the test engine keeps. Unset, 500.
FHEVM_TEST_NODE_LOG_LINES=
